import os
from building import *

cwd = GetCurrentDir()
Import('SIFLI_SDK')

src = Glob('*.c')
CPPPATH = []

# ---------------------------------------------------------------------------
# Modules under test.
#
# Only the pure logic layers are compiled: the protocol codec (xz_proto) and the
# tool registry / JSON-RPC routing (xz_tool). Neither touches the network,
# Bluetooth or audio, so these cases need no peripheral and no stubbing.
#
# xiaozhi.c is deliberately left out: it drags in the channels (WebSocket /
# MQTT), the bootstrap HTTP client and the audio pipeline, which would force
# lwIP, mbedTLS, Opus and the BT stack into this test project - exactly what
# this suite does not intend to cover.
# ---------------------------------------------------------------------------
comp = os.path.join(cwd, '..', '..')

# File(...) is required: a bare path string goes into the linker object list
# verbatim and later blows up in a loop that does not understand it (a known
# trap recorded in unit_test/src/SConscript).
src += [File(os.path.join(comp, 'core', 'proto', 'xz_proto.c'))]
src += [File(os.path.join(comp, 'feature', 'mcp', 'xz_tool.c'))]

CPPPATH += [comp,
            os.path.join(comp, 'core', 'proto'),
            os.path.join(comp, 'feature', 'mcp')]

# ---------------------------------------------------------------------------
# Unity case registry.
#
# Generated by test_registry from the test_*.c files actually compiled above;
# case and suite names are derived from the function and file names, so there
# is no hand-written unity_suites.c.
#
# The gen/ prefix is required: Glob('*.c') would also see the variant directory,
# and a file written straight to build_<board>/src/ would be picked up as an
# ordinary source on the next run and linked twice.
# ---------------------------------------------------------------------------
import test_registry

test_sources = [f for f in src if os.path.basename(str(f)).startswith('test_')]
try:
    board = GetOption('board')
except Exception:
    board = None

registry = GetCurrentEnv().Command(
    'gen/unity_suites_gen.c',
    test_sources,
    test_registry.action(board=board))
src += registry

group = DefineGroup('Applications', src, depend=[''], CPPPATH=CPPPATH)

Return('group')
